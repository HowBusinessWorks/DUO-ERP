# ─────────────────────────────────────────────────────────────────────────────
# Damina ERP — variabile de mediu
#
# Copiaza fisierul asta in `.env.local` si completeaza valorile.
# `.env.local` e in .gitignore si NU ajunge niciodata in repo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres (Supabase) ──────────────────────────────────────────────────────
# Doua connection string-uri distincte, intentionat:
#   DATABASE_URL         transaction pooling (portul 6543) — rutele serverless
#   DATABASE_URL_SESSION session pooling (portul 5432)     — worker si migratii
# Worker-ul are nevoie de LISTEN/NOTIFY, care nu exista in transaction pooling.
# Supabase: Project Settings -> Database -> Connection string
DATABASE_URL=
DATABASE_URL_SESSION=

# Parola rolului `app_runtime`, rolul cu care se conecteaza aplicatia.
# Minim 16 caractere. Se aplica o singura data, cu:
#   pnpm --filter @damina/db db:set-runtime-password
APP_RUNTIME_PASSWORD=

# Deblocheaza `pnpm db:reset`, care STERGE tot. Doar in medii de dezvoltare.
ALLOW_DB_RESET=

# ── Supabase Auth ────────────────────────────────────────────────────────────
# Project Settings -> API. Cu ele completate, aplicatia cere login real.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUMAI in worker, in scripturi si in rute /api dedicate. Nu ajunge niciodata in
# client — verificat automat de `pnpm scan:secrets`. Ceruta de `pnpm db:seed:users`.
SUPABASE_SERVICE_ROLE_KEY=

# Parola conturilor create de `pnpm db:seed:users`. Lipsa, se genereaza una si
# se afiseaza o singura data, la finalul rularii.
SEED_USER_PASSWORD=

# Reaprinde sesiunea de dezvoltare (administrator implicit, fara login) chiar si
# cu Supabase configurat. Doar local — vezi apps/web/src/lib/supabase/config.ts.
ALLOW_DEV_SESSION=

# Opreste poarta de al doilea factor (`MFA_ENFORCED=0`). Drepturile NU se schimba:
# un admin ramane admin, doar nu mai e trimis la /doi-pasi. Exista pentru deploy-uri
# de test, unde un cod de 6 cifre la fiecare intrare face testarea sa nu se mai
# faca. Cand e pornit, shell-ul arata o banda roșie pe fiecare ecran — dinadins:
# garantia e vizibila, nu ascunsa intr-o variabila pe care nimeni n-o verifica.
# NU se pune pe mediul cu date reale.
MFA_ENFORCED=

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
# R2_ACCOUNT_ID e in URL-ul dashboard-ului: dash.cloudflare.com/<account_id>/r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Patru bucket-uri, cu politici de retentie diferite:
#   docs     versiuni de fisiere, PDF-uri finale     — fara expirare
#   derived  thumbnails, previzualizari              — expirare 180 zile
#   tmp      uploaduri incomplete, artefacte de job  — expirare 7 zile
#   archive  rapoarte inghetate, audit               — Infrequent Access
R2_BUCKET_DOCS=
R2_BUCKET_DERIVED=
R2_BUCKET_TMP=
R2_BUCKET_ARCHIVE=

# ── Joburi ───────────────────────────────────────────────────────────────────
PGBOSS_SCHEMA=jobs
# Identifica worker-ul in jobs.worker_heartbeat si in jobs.ping_log.
WORKER_ID=

# ── Observabilitate ──────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Aplicatie ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
APP_TIMEZONE=Europe/Bucharest
APP_DEFAULT_LOCALE=ro-RO

# ─────────────────────────────────────────────────────────────────────────────
# Integrari externe — se completeaza in fazele lor, nu acum.
# ─────────────────────────────────────────────────────────────────────────────
# ANAF SPV / e-Factura (faza 3+)
# ANAF_CLIENT_ID=
# ANAF_CLIENT_SECRET=
# ANAF_CERT_REF=

# Ingest email -> Cereri (pasul 08)
# MAIL_IMAP_HOST=
# MAIL_IMAP_USER=
# MAIL_OAUTH_REFRESH_TOKEN=

# Pret motorina (faza 4)
# FUEL_PRICE_SOURCE_URL=
