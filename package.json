{
  "name": "damina-erp",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "turbo run test:db",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "db:generate": "pnpm --filter @damina/db db:generate",
    "db:migrate": "pnpm --filter @damina/db db:migrate",
    "db:reset": "pnpm --filter @damina/db db:reset",
    "db:seed": "pnpm --filter @damina/services db:seed",
    "scan:secrets": "node tools/scripts/scan-bundle-secrets.mjs"
  },
  "devDependencies": {
    "@damina/eslint-config": "workspace:*",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "handlebars": "^4.7.9",
      "postcss": "^8.5.26",
      "sharp": "^0.35.3"
    }
  }
}
