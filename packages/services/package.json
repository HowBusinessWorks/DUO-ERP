    "@supabase/supabase-js": "^2.112.4",
    "@testcontainers/postgresql": "^11.0.3",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.23.1",
    "pg": "^8.16.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
