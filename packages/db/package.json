{
  "name": "@damina/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.ts --dir tests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:set-runtime-password": "tsx scripts/set-runtime-password.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@damina/shared": "workspace:*",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@damina/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
}
